# Copy these into Hostinger > Node.js app > Environment variables.
# Do not upload a real .env file with passwords to a public repository.

NODE_ENV=production

# REQUIRED: a long random text (40+ characters). The server will not start without it.
JWT_SECRET=replace-with-a-long-random-secret

# Set to true once the site uses https (Hostinger SSL)
COOKIE_SECURE=true

# Admin login (created on first start)
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=choose-a-strong-password

# Database and uploads: outside the app folder so redeploys keep them.
# Create these folders in the Hostinger File Manager first, e.g. /home/<user>/opentale-data/
DB_FILE=/home/REPLACE_USER/opentale-data/opentale.db
UPLOAD_DIR=/home/REPLACE_USER/opentale-data/uploads

# Email for verification codes (any SMTP provider, e.g. Hostinger email, Brevo, Resend)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your-smtp-password
MAIL_FROM=Open Tale <no-reply@yourdomain.com>
